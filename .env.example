# CleanSheet AI Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (optional - app works without it using rule-based recommendations)
# OPENAI_API_KEY=sk-your-api-key-here

# OpenAI Model (optional, defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Enable AI features (set to 'true' to enable, requires OPENAI_API_KEY)
# AI_ENABLED=false

# Maximum file upload size in MB (default: 200)
# MAX_FILE_SIZE_MB=200

# Default fuzzy matching similarity threshold (0-100, default: 85)
# DEFAULT_SIMILARITY_THRESHOLD=85
